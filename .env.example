# Copy to .env for local development. Never commit .env.
# Every variable is optional for local development; see notes for production.

# Gemini API key from https://aistudio.google.com/apikey
# Leave empty to use the built-in rule-based fallback instead of Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Abort Gemini calls after this many milliseconds and fall back to rules.
GEMINI_TIMEOUT_MS=8000

# Secret used to sign session tokens (any random string, 32+ characters).
# Required when NODE_ENV=production. If empty in development, a random one is
# generated at startup (sessions then reset whenever the server restarts).
SESSION_SECRET=

# development | production | test
NODE_ENV=development
PORT=8080

# memory (default, seeded demo data) or firestore (persistent)
PERSISTENCE=memory
# Required only when PERSISTENCE=firestore (uses Application Default Credentials).
GOOGLE_CLOUD_PROJECT=
